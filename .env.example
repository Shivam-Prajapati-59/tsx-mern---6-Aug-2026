# Copy to .env.local (or set in your host's environment variables).
# Without these, safe dev-only defaults are used.

# Secret used to sign the mock JWTs. Set a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

# Access token lifetime in seconds. Kept short (120s) so the silent refresh
# can be observed. Increase for production.
JWT_ACCESS_EXPIRES=120

# Refresh token lifetime in seconds.
JWT_REFRESH_EXPIRES=3600
